filters:
  and:
    - file.ext == "md"
    - contains(file.name, "agent-team-plan")

properties:
  note.status:
    displayName: Status
  note.team_size:
    displayName: Team
  note.lead_model:
    displayName: Lead
  note.teammate_model:
    displayName: Teammates
  note.started:
    displayName: Started
  note.completed:
    displayName: Completed
  note.iterations:
    displayName: Iterations
  note.test_layers:
    displayName: Layers
  note.outcome:
    displayName: Outcome

formulas:
  duration: |
    if(note.completed && note.started, note.completed - note.started, "")

views:
  - type: table
    name: All Runs
    order:
      - file.name
      - note.status
      - note.outcome
      - note.team_size
      - note.iterations
      - note.started
      - note.completed
      - formula.duration
      - note.test_layers

  - type: table
    name: In Progress
    filters:
      and:
        - note.status == "In Progress"
    order:
      - file.name
      - note.team_size
      - note.iterations
      - note.started
      - note.test_layers

  - type: table
    name: Failed or Needs Rework
    filters:
      or:
        - note.outcome == "failed"
        - note.outcome == "partial"
        - note.status == "Needs Rework"
    order:
      - file.name
      - note.outcome
      - note.iterations
      - note.team_size
      - note.completed

  - type: table
    name: By Outcome
    order:
      - note.outcome
      - file.name
      - note.iterations
      - note.completed
